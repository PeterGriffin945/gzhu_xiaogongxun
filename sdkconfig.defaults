# 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# 1ms 系统节拍：ADS 转换等待、100Hz 控制环、1kHz 步进斜坡
CONFIG_FREERTOS_HZ=1000

# 主任务栈（Wi-Fi + HTTP 初始化）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 2MB Flash 使用 1500K 应用分区，避免 Wi-Fi + HTTP 固件逼近 1MB 上限
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 20kHz 脉冲 ISR 实时性：GPIO 控制函数与 GPTimer ISR 放入 IRAM
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_ISR_CACHE_SAFE=y

# Wi-Fi 关闭省电在代码中通过 esp_wifi_set_ps(WIFI_PS_NONE) 完成
